# ============================================================
# CHOICE PROPERTIES — GITIGNORE
# ============================================================

# CRITICAL: config.js is generated at Cloudflare Pages build time ONLY.
# Never commit — it would leak credentials and break the deployment pipeline.
config.js
config.*.js
apply/config.js

# credentials-config.js is COMMITTED intentionally — it holds the shared
# public config + write secret that any fork needs. Do NOT ignore it.
!credentials-config.js

# .env files are blocked by default — EXCEPT scraper/.env which carries
# permanent pipeline credentials so any Replit import works without manual setup.
.env
.env.*
*.env
.env.local
.env.*.local
!scraper/.env

# chrome-extension/config.js is the extension's credential config — committed
# intentionally so it travels with the project everywhere (GitHub, forks, imports).
# This is separate from the Cloudflare-generated config.js for the main site.
!chrome-extension/config.js

# .pages-orion/config.js is the Orion extension's credential config — committed
# so the live loader has the secret for auto-updates.
!.pages-orion/config.js

# Node modules — never commit generated/installed files
node_modules/
package-lock.json.bak

# ============================================================
# REPLIT — ALL FILES IGNORED (project runs on Cloudflare only)
# These files must never appear in GitHub or any deployment.
# ============================================================
.replit
replit.nix
REPLIT.md
replit.md
REPLIT_SAFETY.md
.replit-guard.js
.replit-cache/
.replit-backup/
.upm/
replit_zip_error_log.txt
.cache/
.local/
.config/
.npm/
.nvm/
server.js
_dev_preview.js
.agents/

# Database files (not applicable — DB is Supabase cloud-hosted)
*.db
*.sqlite
*.sqlite3
*.sql.bak
migrations/*.sql.bak

# OS / editor noise
.DS_Store
Thumbs.db
.swp
.swo
*~
*.tmp
.idea/
.vscode/settings.json
launch.json

# Uploaded / temporary assets
attached_assets/
uploads/
downloads/
temp/
tmp/

# Supabase CLI temp files — never commit (contains linked project ref, URLs)
supabase/.temp/
supabase/supabase/.temp/

# Build artifacts
dist/
build/
out/

# Logs
*.log
logs/

# Python bytecode / cache — do not commit
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.mypy_cache/

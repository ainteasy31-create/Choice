{
  "manifest_version": 3,
  "name": "Import to Choice Properties",
  "version": "2.0.0",
  "description": "Save any Zillow, Realtor.com, Apartments.com, or Redfin listing to your Choice Properties pipeline with one click — all fields and photos captured. Optional Download-to-PC and offline queue.",
  "permissions": ["tabs", "storage", "downloads"],
  "host_permissions": [
    "https://www.zillow.com/*",
    "https://www.realtor.com/*",
    "https://www.apartments.com/*",
    "https://www.redfin.com/*",
    "https://photos.zillowstatic.com/*",
    "https://tlfmwetmhthpyrytrcfo.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.zillow.com/homedetails/*",
        "https://www.realtor.com/realestateandhomes-detail/*",
        "https://www.apartments.com/*",
        "https://www.redfin.com/*"
      ],
      "js": ["shared-extractors.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import to Choice Properties",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

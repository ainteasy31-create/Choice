{
  "manifest_version": 3,
  "name": "Import to Choice Properties",
  "version": "2.1.0",
  "description": "Save Zillow, Realtor.com, Apartments.com, and Redfin listings to your Choice Properties pipeline.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.zillow.com/*",
    "https://www.realtor.com/*",
    "https://www.apartments.com/*",
    "https://www.redfin.com/*",
    "https://tlfmwetmhthpyrytrcfo.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.zillow.com/homedetails/*",
        "https://www.realtor.com/realestateandhomes-detail/*",
        "https://www.apartments.com/*",
        "https://www.redfin.com/*"
      ],
      "js": ["config.js", "shared-extractors.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import to Choice Properties"
  }
}

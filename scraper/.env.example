# Choice Properties — Scraper Environment Variables
# =====================================================
# Copy this file to scraper/.env (git-ignored) and fill in your real values.
# When running via GitHub Actions these are set automatically from Secrets.
#
# HOW TO SET GITHUB SECRETS (one-time setup, permanent):
#   GitHub repo → Settings → Secrets and variables → Actions → New repository secret
#
# NEVER commit the real .env file — it is listed in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────
# GitHub Secret name: SUPABASE_URL
SUPABASE_URL=https://your-project-ref.supabase.co

# GitHub Secret name: SUPABASE_SERVICE_ROLE_KEY
# Get from: Supabase dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhb...your-service-role-key

# ── ImageKit ─────────────────────────────────────────────────────────────
# GitHub Secret name: IMAGEKIT_URL  (pipeline reads this as IMAGEKIT_URL_ENDPOINT)
# Get from: ImageKit dashboard → Developer Options → URL endpoint
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# GitHub Secret name: IMAGEKIT_PRIVATE_KEY
# Get from: ImageKit dashboard → Developer Options → Private Key
IMAGEKIT_PRIVATE_KEY=private_...your-key

# GitHub Secret name: IMAGEKIT_PUBLIC_KEY
# Get from: ImageKit dashboard → Developer Options → Public Key
IMAGEKIT_PUBLIC_KEY=public_...your-key

# ── OpenAI ───────────────────────────────────────────────────────────────
# GitHub Secret name: OPENAI_API_KEY
# Get from: https://platform.openai.com/api-keys
# Used for: AI description rewriting (step 6) and visual watermark detection (step 13a)
# If not set: AI rewriting is skipped gracefully; raw scraped descriptions are used instead.
OPENAI_API_KEY=sk-...your-key

# ── Site / Branding (optional — has safe defaults) ───────────────────────
# GitHub Secret name: SITE_URL
# Published URL of the Cloudflare Pages site (used to build listing URLs in pipeline output)
SITE_BASE_URL=https://choiceproperties.com

# ── Local dev only (not needed in GitHub Actions) ────────────────────────
# These are used by the email relay and edge function probes only.
# GAS_URL=https://script.google.com/macros/s/...your-gas-relay
# GAS_RELAY_SECRET=your-relay-secret
# RESEND_API_KEY=re_...your-key
# NOTIFY_EMAIL=you@example.com

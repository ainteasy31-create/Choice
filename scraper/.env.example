# ============================================================
# Choice Properties — Scraper Credentials
# ============================================================
# Copy this file to .env and fill in your values.
# This file is safe to commit. .env is gitignored (never commit it).
#
# After cloning or importing the repo:
#   cp scraper/.env.example scraper/.env
#   nano scraper/.env   (or open in any editor)
#
# Then run:
#   python scraper/scraper.py --location "Dallas, TX"
# ============================================================


# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Your Supabase project URL (already set to the Choice Properties project).
# Change this only if you move to a different Supabase project.
SUPABASE_URL=https://tlfmwetmhthpyrytrcfo.supabase.co

# Your Supabase service role key.
# Find it: Supabase dashboard → Project Settings → API → "service_role" (secret)
# This key bypasses Row Level Security — never expose it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=


# ── OPTIONAL — Email summaries after each scrape run ──────────────────────────
# Requires a free Resend account at https://resend.com (3,000 emails/month free)
# Leave blank to disable email summaries.

# Resend API key (starts with re_)
RESEND_API_KEY=

# Email address to receive scrape summary reports
NOTIFY_EMAIL=

# Sender address shown in the summary email
# Must be a verified domain in your Resend account
FROM_EMAIL=scraper@choiceproperties.com

# Link included in the summary email pointing to the admin pipeline
ADMIN_URL=https://choice-properties-site.pages.dev/admin/pipeline.html
